ALPACA_API_KEY=your_paper_api_key_here
ALPACA_API_SECRET=your_paper_api_secret_here

# Pushover phone alerts (optional — leave blank to disable alerting)
# See docs/specs/scanner/match-alerts.md
PUSHOVER_TOKEN=
PUSHOVER_USER=

# Alpaca equity data feed. Leave blank on the free plan (IEX: one exchange,
# thin before 09:30). Set to sip after upgrading to Algo Trader Plus — the
# consolidated tape from every exchange, pre-market included.
ALPACA_DATA_FEED=

# Financial Modeling Prep — share float, used by low-float conditions.
# Free tier is enough. Without it, low-float conditions cannot be met.
FMP_API_KEY=
